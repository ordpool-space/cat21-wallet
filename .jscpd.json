{
  "path": [
    "apps/extension/src/background/cat21",
    "apps/extension/src/app/features/cat21-confirmation",
    "apps/extension/src/app/common/cat21-bazaar",
    "apps/extension/src/app/pages/cat21-mint",
    "apps/extension/src/app/pages/cat21-agent-policy-wizard",
    "apps/extension/src/app/pages/cat21-shared",
    "apps/extension/src/app/pages/cat21-transfer",
    "apps/extension/src/app/pages/cat21-list",
    "packages/services/src/collectibles/cat21-asset.service.ts",
    "packages/utils/src/assets/cat21-helpers.ts"
