{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "dist-*/**",
        "build/**",
        "{ios,android,build}/**",
        "leather-styles/**"
      ],
      "dependsOn": [
        "^build"
      ],
      "env": [
        "WALLET_ENVIRONMENT",
        "NODE_ENV",
        "TARGET_BROWSER",
        "PREVIEW_RELEASE",
        "ANALYZE",
        "BUILD_TARGET",
        "COMMIT_SHA",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "build:watch": {},
    "format": {},
    "format:check": {},
    "lint": {},
    "lint:fix": {},
    "test:unit": {},
    "test:coverage": {},
    "typecheck": {},
    "check:all": {
      "dependsOn": [
        "build",
        "format",
        "typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
